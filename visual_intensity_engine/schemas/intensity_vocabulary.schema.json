{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maryatta8200-ops/visual-motion-detection1/schemas/intensity_vocabulary.schema.json",
  "title": "VIE intensity vocabulary",
  "description": "vie.vocabulary/1 — machine-readable identity for every discrete intensity level (MASTER_PLAN §5, VIE-SPEC-REP §5).",
  "type": "object",
  "properties": {
    "schema": { "const": "vie.vocabulary/1" },
    "vocabulary_version": { "type": "string", "pattern": "^[a-z0-9]+-l[0-9]+-v[0-9]+$" },
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["uniform"] },
        "levels": { "type": "integer", "minimum": 2, "maximum": 256 },
        "scope": { "enum": ["global_fixed"] },
        "boundary_rule": { "enum": ["floor_right_open"] }
      },
      "required": ["strategy", "levels", "scope", "boundary_rule"]
    },
    "source_domain": {
      "description": "Domain the intervals refer to: normalized luminance produced with a specific luma standard.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "normalized_luminance" },
        "luma_standard": { "enum": ["bt601", "bt709", "average"] },
        "range": { "const": [0.0, 1.0] }
      },
      "required": ["kind", "luma_standard", "range"]
    },
    "palette_seed": { "type": "integer", "minimum": 0 },
    "tokens": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token_id": { "type": "integer", "minimum": 0, "maximum": 255 },
          "symbol": { "type": "string", "pattern": "^I[0-9]+$" },
          "label": { "type": "string", "minLength": 1 },
          "lower_inclusive": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "upper_exclusive": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
          "upper_inclusive": { "type": "boolean" },
          "representative_value": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "semantic_metadata": { "type": ["object", "null"] }
        },
        "required": ["token_id", "symbol", "label", "lower_inclusive", "upper_exclusive", "upper_inclusive", "representative_value", "semantic_metadata"]
      }
    }
  },
  "required": ["schema", "vocabulary_version", "quantization", "source_domain", "palette_seed", "tokens"],
  "additionalProperties": false
}
