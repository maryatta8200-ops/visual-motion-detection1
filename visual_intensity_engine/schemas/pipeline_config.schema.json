{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maryatta8200-ops/visual-motion-detection1/schemas/pipeline_config.schema.json",
  "title": "VIE pipeline configuration",
  "description": "vie.pipeline-config/1 — versioned configuration for the Phase 1 intensity pipeline. additionalProperties:false everywhere so typos fail loudly (MASTER_PLAN §3.8).",
  "type": "object",
  "properties": {
    "schema": { "const": "vie.pipeline-config/1" },
    "config_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "seed": { "type": "integer", "minimum": 0 },
    "max_frames": { "type": "integer", "minimum": 1 },
    "strict": { "type": "boolean" },
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "description": "Only 'uniform' is implemented in Phase 1; other strategies are extension points and MUST fail config validation until specified+tested (MASTER_PLAN §6).",
          "enum": ["uniform"]
        },
        "levels": { "type": "integer", "minimum": 2, "maximum": 256 },
        "scope": { "enum": ["global_fixed"] },
        "boundary_rule": { "enum": ["floor_right_open"] },
        "implementation": { "enum": ["reference"] }
      },
      "required": ["strategy", "levels", "scope", "boundary_rule", "implementation"]
    },
    "input_domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel_order": { "enum": ["RGB"] },
        "luma_standard": { "enum": ["bt601", "bt709", "average"] },
        "normalization": { "enum": ["dtype_max"] },
        "alpha_policy": { "enum": ["drop", "composite_black", "error"] },
        "non_finite_policy": { "enum": ["strict", "coerce"] },
        "float_range_policy": { "enum": ["strict", "clip"] }
      },
      "required": ["channel_order", "luma_standard", "normalization", "alpha_policy", "non_finite_policy", "float_range_policy"]
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["vie-framestore/1"] },
        "deterministic": { "type": "boolean" }
      },
      "required": ["format", "deterministic"]
    }
  },
  "required": ["schema", "config_version", "seed", "quantization", "input_domain", "serialization"],
  "additionalProperties": false
}
