{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maryatta8200-ops/visual-motion-detection1/schemas/object_benchmark_result.schema.json",
  "title": "VIE intensity-object benchmark result",
  "description": "vie.object-benchmark-result/1 — machine-readable cost measurements for Phase 2 object extraction (EXP-0002; MASTER_PLAN §19, §25, §36). Metadata overhead is reported explicitly: a representation is not compact if indexing/records are excluded.",
  "type": "object",
  "properties": {
    "schema": { "const": "vie.object-benchmark-result/1" },
    "experiment_id": { "type": "string", "pattern": "^EXP-[0-9]{4}(-[a-z0-9-]+)?$" },
    "title": { "type": "string", "minLength": 1 },
    "research_questions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "hypotheses": { "type": "array", "items": { "type": "string" } },
    "code_commit": { "type": ["string", "null"] },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "warmup_frames": { "type": "integer", "minimum": 0 },
    "repeats_per_condition": { "type": "integer", "minimum": 1 },
    "measurement_method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock": { "type": "string" },
        "memory": { "type": "string" },
        "timer_resolution_note": { "type": "string" }
      },
      "required": ["clock", "memory", "timer_resolution_note"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python_version": { "type": "string" },
        "numpy_version": { "type": "string" },
        "platform": { "type": "string" },
        "cpu_model": { "type": ["string", "null"] },
        "cpu_count": { "type": ["integer", "null"], "minimum": 1 }
      },
      "required": ["python_version", "numpy_version", "platform", "cpu_model", "cpu_count"]
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "condition_id": { "type": "string", "minLength": 1 },
          "scene": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "levels": { "type": "integer", "minimum": 2, "maximum": 256 },
          "connectivity": { "const": 4 },
          "min_area": { "type": "integer", "minimum": 1 },
          "max_regions": { "type": ["integer", "null"], "minimum": 1 },
          "noise_px": { "type": "integer", "minimum": 0 },
          "extraction_ns": { "$ref": "#/$defs/timingStats" },
          "regions_per_frame": { "$ref": "#/$defs/countStats" },
          "dropped_per_frame": { "$ref": "#/$defs/countStats" },
          "peak_alloc_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "bytes_per_frame": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "raw_rgb": { "type": "integer", "minimum": 0 },
              "intensity_u8": { "type": "integer", "minimum": 0 },
              "labels_i32": { "type": "integer", "minimum": 0 },
              "region_metadata_json": { "type": "integer", "minimum": 0 }
            },
            "required": ["raw_rgb", "intensity_u8", "labels_i32", "region_metadata_json"]
          },
          "totals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "regions_kept": { "type": "integer", "minimum": 0 },
              "regions_dropped": { "type": "integer", "minimum": 0 },
              "dropped_pixels": { "type": "integer", "minimum": 0 }
            },
            "required": ["regions_kept", "regions_dropped", "dropped_pixels"]
          }
        },
        "required": ["condition_id", "scene", "width", "height", "levels", "connectivity", "min_area", "max_regions", "noise_px", "extraction_ns", "regions_per_frame", "dropped_per_frame", "peak_alloc_bytes", "bytes_per_frame", "totals"]
      }
    }
  },
  "required": ["schema", "experiment_id", "title", "research_questions", "hypotheses", "code_commit", "created_at_utc", "warmup_frames", "repeats_per_condition", "measurement_method", "environment", "conditions"],
  "$defs": {
    "timingStats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "mean": { "type": "number", "minimum": 0 },
        "std": { "type": "number", "minimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      },
      "required": ["n", "mean", "std", "min", "p50", "p95", "p99", "max"]
    },
    "countStats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "mean": { "type": "number", "minimum": 0 },
        "std": { "type": "number", "minimum": 0 },
        "min": { "type": "integer", "minimum": 0 },
        "p50": { "type": "integer", "minimum": 0 },
        "p95": { "type": "integer", "minimum": 0 },
        "p99": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      },
      "required": ["n", "mean", "std", "min", "p50", "p95", "p99", "max"]
    }
  }
}
