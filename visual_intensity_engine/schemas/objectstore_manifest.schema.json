{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maryatta8200-ops/visual-motion-detection1/schemas/objectstore_manifest.schema.json",
  "title": "VIE object-store manifest",
  "description": "vie.objectstore-manifest/1 — self-describing metadata for a vie-objectstore/1 bundle: region_labels.npz + regions.json + checksums.json (VIE-SPEC-REP 1.1.0 §R7).",
  "type": "object",
  "properties": {
    "schema": { "const": "vie.objectstore-manifest/1" },
    "stage": { "const": "phase2" },
    "config": { "$ref": "pipeline_config.schema.json" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "objects_config": { "$ref": "objects_config.schema.json" },
    "objects_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vocabulary": { "$ref": "intensity_vocabulary.schema.json" },
    "regions_schema": { "const": "vie.region-set/1" },
    "input": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["synthetic", "video_file", "image_directory", "camera"] },
        "name": { "type": "string" },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "declared_fps": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["kind", "name", "sha256", "declared_fps", "width", "height"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_commit": { "type": ["string", "null"] },
        "git_dirty": { "type": ["boolean", "null"] },
        "python_version": { "type": "string" },
        "numpy_version": { "type": "string" },
        "pillow_version": { "type": ["string", "null"] },
        "jsonschema_version": { "type": ["string", "null"] },
        "platform": { "type": "string" },
        "created_at_utc": { "type": "string", "format": "date-time" },
        "duration_s": { "type": ["number", "null"], "minimum": 0 },
        "seed": { "type": "integer", "minimum": 0 }
      },
      "required": ["git_commit", "git_dirty", "python_version", "numpy_version", "pillow_version", "jsonschema_version", "platform", "created_at_utc", "duration_s", "seed"]
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frame_index": { "type": "integer", "minimum": 0 },
          "npz_key": { "type": "string", "pattern": "^f[0-9]{6}$" },
          "source_frame_id": { "type": ["string", "null"] },
          "timestamp_us": { "type": "integer", "minimum": 0 },
          "wall_time_utc": { "type": ["string", "null"], "format": "date-time" },
          "height": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "region_count": { "type": "integer", "minimum": 0 },
          "dropped_regions": { "type": "integer", "minimum": 0 },
          "dropped_pixels": { "type": "integer", "minimum": 0 },
          "label_dtype": { "const": "int32" },
          "warnings": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["frame_index", "npz_key", "source_frame_id", "timestamp_us", "wall_time_utc", "height", "width", "region_count", "dropped_regions", "dropped_pixels", "label_dtype", "warnings"]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frames": { "type": "integer", "minimum": 0 },
        "regions": { "type": "integer", "minimum": 0 },
        "dropped_regions": { "type": "integer", "minimum": 0 },
        "dropped_pixels": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      },
      "required": ["frames", "regions", "dropped_regions", "dropped_pixels", "warnings"]
    },
    "npz_key_format": { "const": "f%06d" }
  },
  "required": ["schema", "stage", "config", "config_sha256", "objects_config", "objects_config_sha256", "vocabulary", "regions_schema", "input", "provenance", "frames", "counts", "npz_key_format"],
  "additionalProperties": false
}
